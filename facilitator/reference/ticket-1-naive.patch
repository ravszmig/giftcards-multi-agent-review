@@ -0,0 +1,54 @@
+package com.example.giftcard.domain;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import com.example.giftcard.adapter.jdbc.JdbcGiftCardRepository;
+import com.example.giftcard.adapter.jdbc.JdbcLedgerRepository;
+import com.example.giftcard.adapter.web.StoreWebhookNotifier;
+import com.example.giftcard.support.Clocks;
+import com.example.giftcard.support.TestDatabase;
+import java.util.Random;
+import javax.sql.DataSource;
+import org.junit.jupiter.api.Test;
+
+class RefundServiceTest {
+
+  private final DataSource db = TestDatabase.migrated();
+  private final JdbcGiftCardRepository repository = new JdbcGiftCardRepository(db);
+  private final CardService cards = new CardService(repository, new Random(7), Clocks.fixed());
+  private final RedemptionService redemptions = new RedemptionService(repository, Clocks.fixed());
+  private final RefundService refunds = new RefundService(repository,
+      new JdbcLedgerRepository(db), Clocks.fixed(), new StoreWebhookNotifier(null));
+
+  @Test
+  void partialRefundsAddUpToTheRedemption() {
+    final CardNumber number = cards.issue(Money.parse("50.00")).number();
+    final long id = redemptions.redeem(number, Money.parse("20.00"), "S-1").id();
+    refunds.refund(number, id, Money.parse("15.00"), "S-1");
+    final LedgerEntry last = refunds.refund(number, id, Money.parse("5.00"), "S-1");
+    assertEquals(EntryKind.REFUND, last.kind());
+    assertEquals(Long.valueOf(id), last.relatedEntryId());
+    assertEquals(Money.parse("50.00"), cards.balance(number).balance());
+  }
+
+  @Test
+  void goodwillAllowsUpToFiftyPoundsAboveTheRedemption() {
+    final CardNumber number = cards.issue(Money.parse("50.00")).number();
+    final long id = redemptions.redeem(number, Money.parse("20.00"), "S-1").id();
+    refunds.refund(number, id, Money.parse("70.00"), "S-1");
+    final DomainRuleException e = assertThrows(DomainRuleException.class,
+        () -> refunds.refund(number, id, Money.parse("0.01"), "S-1"));
+    assertEquals("REFUND_EXCEEDS_REDEMPTION", e.code());
+  }
+
+  @Test
+  void aRedemptionOnAnotherCardIsUnknown() {
+    final CardNumber first = cards.issue(Money.parse("50.00")).number();
+    final CardNumber second = cards.issue(Money.parse("50.00")).number();
+    final long id = redemptions.redeem(first, Money.parse("20.00"), "S-1").id();
+    final DomainRuleException e = assertThrows(DomainRuleException.class,
+        () -> refunds.refund(second, id, Money.parse("1.00"), "S-1"));
+    assertEquals("UNKNOWN_REDEMPTION", e.code());
+  }
+}
