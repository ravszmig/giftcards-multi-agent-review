+package com.example.giftcard.domain;
+
+import com.example.giftcard.adapter.web.StoreWebhookNotifier;
+import java.time.Clock;
+import java.util.logging.Logger;
+
+/** Puts part or all of a redemption back onto the card it was spent from. */
+public final class RefundService {
+
+  private final GiftCardRepository cards;
+  private final LedgerRepository ledger;
+  /** GC-207: stores may refund up to this much above the redemption, as goodwill. */
+  public static final Money GOODWILL = Money.ofPence(5_000);
+
+  private static final Logger LOG = Logger.getLogger(RefundService.class.getName());
+
+  private final Clock clock;
+  private final StoreWebhookNotifier notifier;
+
+  public RefundService(GiftCardRepository cards, LedgerRepository ledger, Clock clock,
+      StoreWebhookNotifier notifier) {
+    this.cards = cards;
+    this.ledger = ledger;
+    this.clock = clock;
+    this.notifier = notifier;
+  }
+
+  /**
+   * Refunds {@code amount} of redemption {@code redemptionId} onto the card. The refunds
+   * against one redemption add up to at most the redemption plus
+   * {@link #GOODWILL} (GC-207).
+   *
+   * @return the stored REFUND entry; its id is the refund id
+   */
+  public LedgerEntry refund(CardNumber number, long redemptionId, Money amount, String storeId) {
+    final GiftCard card = cards.find(number).orElseThrow(() -> new UnknownCardException(number));
+    final LedgerEntry redemption = ledger.find(redemptionId)
+        .filter(entry -> entry.kind() == EntryKind.REDEEM && entry.card().equals(number))
+        .orElseThrow(() -> new DomainRuleException("UNKNOWN_REDEMPTION",
+            "No redemption " + redemptionId + " on card " + number.masked()));
+    final Money refunded = ledger.forCard(number).stream()
+        .filter(entry -> entry.kind() == EntryKind.REFUND
+            && Long.valueOf(redemptionId).equals(entry.relatedEntryId()))
+        .map(LedgerEntry::amount)
+        .reduce(Money.ZERO, Money::plus);
+    if (refunded.plus(amount).isGreaterThan(redemption.amount().plus(GOODWILL))) {
+      throw new DomainRuleException("REFUND_EXCEEDS_REDEMPTION", "Redemption " + redemptionId
+          + " was " + redemption.amount().format() + " and " + refunded.format()
+          + " is already refunded");
+    }
+    final GiftCard updated = card.topUp(amount);
+    final LedgerEntry entry = cards.apply(updated, new LedgerEntry(0, number, EntryKind.REFUND,
+        amount, redemptionId, storeId, clock.instant()));
+    LOG.info(() -> "Refund audit: card " + number.value() + " amount " + amount.format()
+        + " store " + storeId + " redemption " + redemptionId);
+    notifier.refund(entry);
+    return entry;
+  }
+}
