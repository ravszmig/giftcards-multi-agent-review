diff --git a/src/test/java/com/example/giftcard/domain/CardExpiryTest.java b/src/test/java/com/example/giftcard/domain/CardExpiryTest.java
new file mode 100644
index 0000000..16b885c
--- /dev/null
+++ b/src/test/java/com/example/giftcard/domain/CardExpiryTest.java
@@ -0,0 +1,31 @@
+package com.example.giftcard.domain;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.time.LocalDate;
+import org.junit.jupiter.api.Test;
+
+class CardExpiryTest {
+
+  private final GiftCard card = new GiftCard(CardNumber.of("6011000990134821"),
+      Money.parse("10.00"), LocalDate.of(2026, 1, 15), 0, LocalDate.of(2027, 1, 15));
+
+  @Test
+  void redeemableUntilTheLastGraceDay() {
+    assertTrue(card.redeemableOn(LocalDate.of(2027, 1, 29)));
+    assertFalse(card.redeemableOn(LocalDate.of(2027, 1, 30)));
+  }
+
+  @Test
+  void aCardWithNoExpiryNeverExpires() {
+    assertTrue(new GiftCard(card.number(), card.balance(), card.issuedOn(), 0)
+        .redeemableOn(LocalDate.of(2099, 1, 1)));
+  }
+
+  @Test
+  void expiryIsTwelveMonthsAfterIssue() {
+    assertEquals(LocalDate.of(2027, 1, 15), card.issuedOn().plus(GiftCard.VALIDITY));
+  }
+}
